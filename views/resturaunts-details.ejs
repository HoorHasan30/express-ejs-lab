<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Restaurant</title>

    <link rel="stylesheet" href="/style.css">
</head>
<body>
    <%- include('./partials/navBar')%>

    <main id="details-main">
        <h1>Resturaunt details</h1>

        <div class="details">
            <p><%= resturaunt.name %></p>
            <p><%= resturaunt.address %></p>

            <p>
                <% if(resturaunt.isOpen){%>
                    <span class="open">Open</span>
                <% } else { %>
                    <span class="closed">Closed</span>
                <% } %>
            </p>

            <p><%= resturaunt.phone %></p>
        </div>

        <div id="display-res-cards">
            <% for (let item of resturaunt.menu) {%>
                <div class="item res-cards">
                    <p><%= item.name %></p>
                    <p>Price: <%= item.price %></p>
                    <p>Rating: <%= item.rating %></p>
                </div>
            <% } %>
        </div>
    </main>
</body>
</html>